require spatial_raster

query I
WITH __input AS (
	SELECT
		1 AS mosaic_id,
		RT_RasterFromFile(file) AS raster
	FROM
		glob('./test/data/mosaic/*.tiff')
),
__mosaic AS (
	SELECT
		RT_RasterMosaic_Agg(raster, options => ['-r', 'bilinear']) AS mosaic
	FROM
		__input
	GROUP BY
		mosaic_id
)
SELECT
	RT_GetGeometry(mosaic) AS result
FROM
	__mosaic
;
----
