POLYGON ((541020 4.6902E+06, 541020 4.79664E+06, 609780 4.79664E+06, 609780 4.6902E+06, 541020 4.6902E+06))

query I
SELECT raster::geometry FROM RT_Read('./test/data/mosaic/SCL.tif-land-clip00.tiff');
----
POLYGON ((541020 4.6902E+06, 541020 4.79664E+06, 609780 4.79664E+06, 609780 4.6902E+06, 541020 4.6902E+06))